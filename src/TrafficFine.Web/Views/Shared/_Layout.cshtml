<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Trafik Ceza Yönetimi</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-logo" src="~/images/sarilar-group-logo.jpg" alt="Sarılar Group" asp-append-version="true" /><span>Trafik Ceza Yönetimi<small>ARAÇ & ONAY TAKİBİ</small></span></a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="account"><span>@User.Identity.Name<small>@(User.IsInRole(Roles.Operations) ? "Operasyon" : User.IsInRole(Roles.Manager) ? "Yönetici" : "Finans")</small></span>
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="button ghost small">Çıkış</button></form></div>
    }
</header>
<div class="shell">
@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar"><p class="nav-label">ÇALIŞMA ALANI</p>
        <nav aria-label="Ana menü">
            <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Genel Bakış</a>
            <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "active" : "")" asp-controller="Vehicles" asp-action="Index">Araçlar</a>
            <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Fines" ? "active" : "")" asp-controller="Fines" asp-action="Index">Trafik Cezaları</a>
            @if (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Finance))
            { <a asp-controller="Fines" asp-action="Index" asp-route-status="@(User.IsInRole(Roles.Manager) ? FineStatus.ManagerApproval : FineStatus.FinanceApproval)">Onay Bekleyenler</a> }
        </nav>
        <div class="side-note">Her karar kayıt altında.<br />Onay geçmişinden süreci takip edin.</div>
    </aside>
}
<main id="main-content">
    @if (TempData["Success"] is string success) { <div class="alert success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert error" role="alert">@error</div> }
    @RenderBody()
    <footer>Junior .NET Case · MVC / EF Core / SQL Server</footer>
</main>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
