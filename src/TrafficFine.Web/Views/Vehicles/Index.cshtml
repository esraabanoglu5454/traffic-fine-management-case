@model IReadOnlyList<Vehicle>
@{ ViewData["Title"] = "Araçlar"; }
<div class="page-heading"><div><span class="eyebrow">FİLO YÖNETİMİ</span><h1>Araçlar</h1><p class="muted">Binek, çekici, dorse ve kiralık araç kayıtları.</p></div>
@if (User.IsInRole(Roles.Operations)) { <a class="button" asp-action="Create">+ Yeni araç</a> }</div>
<section class="card"><form method="get" class="filters"><label class="sr-only" for="search">Araç ara</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Plaka, marka veya model ara" /><button class="button secondary">Ara</button><a asp-action="Index" class="text-link">Temizle</a></form>
<div class="table-wrap"><table><thead><tr><th>Plaka</th><th>Araç tipi</th><th>Marka</th><th>Model</th></tr></thead><tbody>
@foreach (var v in Model) { <tr><td><strong class="plate">@v.Plate</strong></td><td>@Labels.Vehicle(v.Type)</td><td>@v.Brand</td><td>@v.Model</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="4" class="empty">Araç bulunamadı. Yeni bir araç ekleyebilir veya aramayı değiştirebilirsiniz.</td></tr> }
</tbody></table></div><div class="table-footer">@Model.Count araç</div></section>
